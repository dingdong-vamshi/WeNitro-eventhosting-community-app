{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/share/vibe/:id",
      "destination": "https://klyjzbisgycegkkacbjw.supabase.co/functions/v1/share-vibe?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/share/vibe/:id",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; img-src https: data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
