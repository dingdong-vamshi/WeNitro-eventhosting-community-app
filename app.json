{
  "expo": {
    "name": "weNitro-module",
    "slug": "weNitro-module",
    "scheme": "wenitro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/wenitro-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wenitro.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "WeNitro uses selected photos and videos only when you choose to publish a profile photo, vibe, story, community image, or message attachment.",
        "NSCameraUsageDescription": "WeNitro uses the camera only when you choose to capture media for your profile or a post."
      }
    },
    "android": {
      "package": "com.wenitro.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/wenitro-app-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WeNitro to share profile photos, stories, and chat images."
        }
      ],
      "expo-secure-store",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6860F2",
          "image": "./assets/brand/wenitro-mark-white.png",
          "imageWidth": 144
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9504061c-697a-4385-b031-1f5834f6ff41"
      }
    }
  }
}
